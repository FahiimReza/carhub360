{
  "name": "carhub360",
  "version": "1.0.0",
  "description": "CarHub360 - Car rental and buying platform with Node.js backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "frontend": "http-server . -p 3000 -o",
